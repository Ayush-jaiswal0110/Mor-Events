# Copy to .env (or .env.local) at the project root for local development.
# Vite only exposes variables prefixed with VITE_ to the browser — never put
# secrets here, only public/client-safe values.

VITE_API_URL=https://cybershield-backend-new.azurewebsites.net/api

# Google OAuth 2.0 Client ID (Web application type) from Google Cloud Console.
# This is the SAME value as GOOGLE_CLIENT_ID in Backend/.env — it's a public
# identifier by design, not a secret. The client secret is never used here.
VITE_GOOGLE_CLIENT_ID=74957132563-imar95qcv180k95i30ksv6t64ovoq7hl.apps.googleusercontent.com
