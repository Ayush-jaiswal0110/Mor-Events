# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Existing app config (unchanged by the Plan My Trip feature) ---
MONGO_URI=
MONGO_DB_NAME=mor_events
CLOUDINARY_URL=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_HEADER_IMAGE_URL=

# --- Plan My Trip: Google Sign-In ---
# The OAuth Client ID from Google Cloud Console (OAuth 2.0 Client ID, type "Web application").
# This is safe to also expose to the frontend build (VITE_GOOGLE_CLIENT_ID below) — it identifies
# your app, it isn't a secret. This backend verifies every token's audience against it.
GOOGLE_CLIENT_ID=

# --- Plan My Trip: AI provider (pick one, keep the key server-side only) ---
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Plan My Trip: places/routing provider ---
PLACES_PROVIDER=geoapify
GEOAPIFY_API_KEY=

# --- Plan My Trip: cost & abuse controls ---
MAX_TRIP_DAYS=14
MAX_TRAVELERS=20
TRIP_GENERATION_LIMIT_PER_DAY=10
TRIP_REGENERATION_LIMIT_PER_DAY=10
EMAIL_SHARE_LIMIT_PER_DAY=20
